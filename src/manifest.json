{
    "manifest_version": 3,
    "name": "Freno de Fricción",
    "version": "1.0",
    "description": "Añade fricción progresiva a redes sociales para reducir el doomscrolling.",
    "permissions": ["tabs", "storage"],
    "host_permissions": [
      "*://*.twitter.com/*",
      "*://*.x.com/*",
      "*://*.instagram.com/*"
    ],
    "icons": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "assets/icon16.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
      }
    },
    "background": {
      "service_worker": "background/background.js",
      "scripts": ["background/background.js"]
    },
    "content_scripts": [
      {
        "matches": [
          "*://*.twitter.com/*",
          "*://*.x.com/*",
          "*://*.instagram.com/*"
        ],
        "js": ["content/content.js"],
        "css": ["content/styles.css"]
      }
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "frenofriccion@tu-usuario.github.io",
        "strict_min_version": "109.0"
      }
    }
  }